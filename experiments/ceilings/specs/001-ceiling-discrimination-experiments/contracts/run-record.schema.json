{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ceilings/run-record.schema.json",
  "title": "RunRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "instance_id",
    "family_id",
    "arm_id",
    "model_id",
    "replicate",
    "prereg_hash",
    "final_answer",
    "probabilities",
    "correct",
    "refusal",
    "ledger",
    "transcript_ref",
    "provider_request_ids",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "family_id": {
      "type": "string"
    },
    "arm_id": {
      "type": "string",
      "pattern": "^(baseline|E|K|M|A1|A2|A2_single_ref|P1|P2|E\\+K|M\\+K)$"
    },
    "delta_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "small",
        "medium",
        "large",
        null
      ]
    },
    "model_id": {
      "type": "string"
    },
    "replicate": {
      "type": "integer",
      "minimum": 0
    },
    "sweep": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "T": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "flip_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 0.5
        },
        "L_bits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "harness": {
      "type": [
        "object",
        "null"
      ],
      "description": "Harness options in effect (ceilings.options): the non-default options plus a 'resolved' block."
    },
    "prereg_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_answer": {},
    "probabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "sample_answers": {
      "type": "array"
    },
    "correct": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean",
      "description": "false when the adapter detected model substitution or another integrity failure"
    },
    "refusal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "per_agent",
        "tool_calls",
        "messages",
        "total_tokens"
      ],
      "properties": {
        "per_agent": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens",
              "calls"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasoning_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "tool_calls": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "charged_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "messages": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "bits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "total_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "added_vs_baseline": {
          "type": [
            "number",
            "null"
          ]
        },
        "dollars": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "transcript_ref": {
      "type": "string"
    },
    "provider_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
